# microservice specific routes

->          /hmrc-frontend                    hmrcfrontend.Routes

GET         /                                 uk.gov.hmrc.sdecstridefrontend.controllers.WorkspaceController.onPageLoad

GET         /assets/*file                     controllers.Assets.versioned(path = "/public", file: Asset)

GET         /create-thread/thread-type        uk.gov.hmrc.sdecstridefrontend.controllers.createthread.ThreadTypeController.onPageLoad()
POST        /create-thread/thread-type        uk.gov.hmrc.sdecstridefrontend.controllers.createthread.ThreadTypeController.onSubmit()
